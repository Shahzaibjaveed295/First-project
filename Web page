<!Doctype Html>
<html>
<Head>
<title>Webpage Designing</title>
<style>
	.{
		margin:0;
		padding:0;
	}
	.SHAHZAIB{
		width:100%;
		background: url(picture.Jpg);
		background-position:center;
		background-size:cover;
		height:100vh;
	}
	.navbar{
		width:1200px;
		float:left;
		margin:auto;
	}
	.icon{
		width:200px;
		float:left;
		height:70px;
	}
	.logo{
		color:orange;
		font-size: 40px;
		font-family:arial;
		padding-left: 20px;
		float:left;
		padding-top:10px;
	}
	.menu{
		width:400px;
		float:left;
		height:70px;
		letter-spacing: 0px;
	}
	ul{
		float:left;
		display:flex;
		justify-content: center;
		align-items:center;
	}
	ul li{
		list-style: none;
		margin-left: 62px;
		margin-top: 27px;
		font-size: 14px;
	}
	ul li a{
		text-decoration: none;
		color:#fff;
		font-family: arial;
		font-weight:bold;
		transition: 0.4s ease-in-out;
	}
	ul li a:hover{
		color:#00ff15;
	}
	.search{
		width:330px;
		float:left;
		margin-left: 270px;
	}
	.srch{
		font-family: "Time New Roman";
		width:200px;
		height:40px;
		background: transparent;
		border:3px solid #00ffe1;
		margin-top:13px;
		color:#fff;
		border-right: :none;
		font-size: 16px;
		float:left;
		padding:10px;
		border-bottom-left-radius:5px;
		border-top-left-radius:5px;
	}
	.btn{
		width:100px;
		height:40px;
		background: #00ffb7;
		border:2px solid #00ffdd;
		margin-top:13px;
		color:#fff;
		font-size: 15px;
		border-bottom-right-radius:5px;
		border-bottom-right-radius:5px;
	}
	.btn{
		outline:none;
	}
	.srch{
		outline:none;
	}
	.contant{
		width:1200px;
		height:auto;
		margin:auto;
		color:#fff;
		position:relative;
	}
	.par{
		margin-left:20px;
		padding-bottom:25px;
		font-family:arial;
		letter-spacing:1.2px;
		line-height:30px;
		color:lightgreen;
	}
	h1{
		font-family: "Time New Roman";
		font-size:50px;
		padding-left:20px;
		margin-top:9px;
		letter-spacing:2px;
	}
	.cn{
		width:160px;
		height:40px;
		background: #00fff2;
		border:none;
		margin-bottom:10px;
		margin-left:20px;
		font-size:18px;
		border-radius:10px;
		cursor:pointer;
	}
	.cn a{
		text-decoration: none;
		color:black;
		transition: 0.3s;
	}
</style>
</Head>
<body>
	<div class="SHAHZAIB">
		<div class="navbar">
			<div class="icon">
				<h2 class="logo"> MIAN SHAHZAIB</h2>
			</div>
			<div class="menu">
				<ul>
					<li><a href="#">Home</a></li>
					<li><a href="#">About</a></li>
					<li><a href="#">Services</a></li>
					<li><a href="#">Designing</a></li>
					<li><a href="#">Contact</a></li>
				</ul>
			</div>
			<div class="search">
				<input class="srch" type="search" name="" placeholder="Search">
				<a href="#"><button class="btn">Search</button></a>
			</div>
		</div>
		<div class="contant"><br><br><br><br><br><br><br>
			<h1>web Desinging & <br>Development</h1>
			<p class="par"><b>Make Your Own Website<br>
				By Using HTML & CSS.</p></b>
				<button class="cn"><a href="#">JOIN US</a></button>
			</div>
		</div>
	</body>
	</html>



